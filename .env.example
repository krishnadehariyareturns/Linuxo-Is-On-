# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: paste a server ID here to register /startup instantly in that server.
# Leave blank to register globally (takes up to ~1 hour to propagate).
GUILD_ID=

# ---- Logger ----
# development | production. Also controls the default log level and console format.
NODE_ENV=development

# trace | debug | info | warn | error | fatal. Defaults to debug in dev, info in prod.
LOG_LEVEL=

# Discord webhook URLs, one per category. Leave any blank to disable that
# category — an unconfigured category with content routed to it falls back
# to LOG_WEBHOOK_LOGS if that's set, so it's fine to only configure one or two.
# Create these under a channel's Settings -> Integrations -> Webhooks.
LOG_WEBHOOK_LOGS=
LOG_WEBHOOK_ERRORS=
LOG_WEBHOOK_SECURITY=
LOG_WEBHOOK_PERFORMANCE=
LOG_WEBHOOK_DEBUG=

# Optional: also append every log record as a JSON line to this file.
LOG_FILE=

# --- Advanced (defaults are almost always fine) ---
# LOG_CONSOLE=true
# LOG_JSON=false
# LOG_WEBHOOK_ENABLED=true
# LOG_WEBHOOK_BATCH_SIZE=10
# LOG_WEBHOOK_FLUSH_MS=1000
# LOG_WEBHOOK_RETRY_LIMIT=5
# LOG_WEBHOOK_MAX_QUEUE=500
# LOG_WEBHOOK_HIGH_WATER=200
# LOG_WEBHOOK_CIRCUIT_THRESHOLD=5
# LOG_WEBHOOK_CIRCUIT_COOLDOWN_MS=30000
# LOG_SLOW_COMMAND_MS=1000
# LOG_WARN_COMMAND_MS=500
# LOG_INCLUDE_MEMORY=true
# LOG_MEMORY_SAMPLE_MS=300000
# LOG_SUMMARY_INTERVAL_MS=0
# LOG_REDACTION_ENABLED=true
# LOG_MAX_STRING_LENGTH=500
# LOG_DEDUP_WINDOW_MS=60000
# LOG_STATS_WINDOW_SIZE=500
